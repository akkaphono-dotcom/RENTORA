generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String
  role           String    @default("TENANT") // TENANT, LANDLORD, ADMIN
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  properties     Property[]
  rentalRequests RentalRequest[]
  favorites      Favorite[]
  reviews        Review[]
}

model Property {
  id            String    @id @default(cuid())
  title         String
  description   String
  type          String
  price         Float
  location      String
  address       String
  bedrooms      Int
  bathrooms     Int
  area          Float
  parking       Int
  furnished     Boolean   @default(false)
  petFriendly   Boolean   @default(false)
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  latitude      Float?
  longitude     Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  landlordId    String
  landlord      User      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  
  images          PropertyImage[]
  amenities       PropertyAmenity[]
  rentalRequests  RentalRequest[]
  favorites       Favorite[]
  reviews         Review[]
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id    String @id @default(cuid())
  name  String @unique
  icon  String?
  
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  
  @@id([propertyId, amenityId])
}

model RentalRequest {
  id             String   @id @default(cuid())
  tenantId       String
  propertyId     String
  moveInDate     DateTime
  duration       Int      // in months
  residents      Int
  message        String?
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

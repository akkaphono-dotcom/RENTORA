# Environment Variables

# Prisma database URL (SQLite by default for local development)
DATABASE_URL="file:./dev.db"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-key-replace-me-in-production"

# Map API Key (Optional: replace with real key when integrating Maps)
NEXT_PUBLIC_MAP_API_KEY="placeholder-key"

# Storage URL (Optional: replace with Cloudinary/S3 URL when adding image uploads)
STORAGE_URL="placeholder-url"
